+/** Complete Router calldata; supplied by the service's execution-plan builder. */
+export interface TempoExecutionPlan {
+  to: string;
+  from: string;
+  data: string;
+  value: string;
+  recipient: string;
+  deadline: number;
+  minimumOutput: bigint;
+}
+
+export interface TempoAdmissionRequest {
+  route: RouteBasic<Pool>;
+  routeKey: string;
+  amountIn: bigint;
+  quotedAmountOut: bigint;
+  chainId: number;
+  blockNumber: number;
+  blockHash: string;
+}
+
+export interface TempoExecutionValidation {
+  status: 'success' | 'failed' | 'indeterminate';
+  routeKey: string;
+  amountIn: bigint;
+  chainId: number;
+  blockNumber: number;
+  blockHash: string;
+  planKey: string;
+  grossOutputTransfer: bigint;
+  recipientDelta: bigint;
+  feePayer?: string;
+  feeToken?: string;
+  feeTokenTransfers?: TempoTokenTransfer[];
+  outputTokenTransfers: TempoTokenTransfer[];
+}
+
+export interface TempoTokenTransfer {
+  from: string;
+  to: string;
+  amount: bigint;
+}
+
+/** The private service must implement both operations against the same state. */
+export interface TempoAdmissionBoundary {
+  buildPlan(request: TempoAdmissionRequest): Promise<TempoExecutionPlan>;
+  validate(
+    request: TempoAdmissionRequest,
+    plan: TempoExecutionPlan
+  ): Promise<TempoExecutionValidation>;
+}
+
+export function tempoPlanKey(plan: TempoExecutionPlan): string {
+  return [plan.to, plan.from, plan.data, plan.value, plan.recipient,
+    String(plan.deadline), plan.minimumOutput.toString()].join('|').toLowerCase();
+}
+
+function tempoRouteKey(route: RouteBasic<Pool>, input: string): string {
+  return [input.toLowerCase(), String(route.percentage),
+    ...route.path.map(pool => {
+      const hop = pool as V4Pool;
+      return [hop.poolId, hop.hooks, hop.token0.address, hop.token1.address]
+        .join(':').toLowerCase();
+    })].join('|');
+}
+
+/** Reconcile the executed swap transfer with a receipt-proven gas charge. */
+export function tempoRecipientSwapOutput(
+  validation: TempoExecutionValidation,
+  plan: TempoExecutionPlan,
+  outputToken: string
+): bigint {
+  const recipient = plan.recipient.toLowerCase();
+  const swaps = (validation.outputTokenTransfers ?? []).filter(transfer =>
+    eqAddress(transfer.from, TEMPO_MANAGER) && eqAddress(transfer.to, recipient)
+  );
+  if (swaps.length !== 1 || swaps[0]!.amount !== validation.grossOutputTransfer) {
+    throw new Error('executed swap output transfer is missing or ambiguous');
+  }
+  let outputTokenGasPaid = 0n;
+  if (validation.feePayer && validation.feeToken &&
+      eqAddress(validation.feePayer, recipient) && eqAddress(validation.feeToken, outputToken)) {
+    const fees = validation.feeTokenTransfers ?? [];
+    if (fees.length !== 1 || !eqAddress(fees[0]!.from, recipient) ||
+        !eqAddress(fees[0]!.to, TEMPO_FEE_COLLECTOR) || fees[0]!.amount <= 0n) {
+      throw new Error('recipient gas payment is not isolated');
+    }
+    outputTokenGasPaid = fees[0]!.amount;
+  }
+  const swapOutput = validation.recipientDelta + outputTokenGasPaid;
+  if (swapOutput !== swaps[0]!.amount) {
+    throw new Error('recipient output token flows do not reconcile');
+  }
+  return swapOutput;
+}
