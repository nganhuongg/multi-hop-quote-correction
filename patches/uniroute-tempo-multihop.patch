+/** Only the two previously fork-validated cUSD -> PathUSD -> USDT0/USDC.e routes. */
+export function isSupportedTempoMultiHopRoute(
+  route: RouteBasic<Pool>,
+  chainId?: number,
+  tradeType?: TradeType,
+  tokenIn?: CurrencyInfo,
+  blockNumber?: number
+): boolean {
+  if (chainId !== TEMPO_CHAIN_ID || tradeType !== TradeType.ExactIn ||
+      blockNumber !== TEMPO_VERIFIED_BLOCK || route.path.length !== 2 || !tokenIn) return false;
+  const [first, second] = route.path as V4Pool[];
+  if (!first || !second || typeof first.hooks !== 'string' ||
+      typeof second.hooks !== 'string' || !first.token0 || !first.token1 ||
+      !second.token0 || !second.token1 || typeof first.poolId !== 'string' ||
+      typeof second.poolId !== 'string') return false;
+  if (first.fee !== 500 || second.fee !== 500 ||
+      first.tickSpacing !== 10 || second.tickSpacing !== 10) return false;
+  const validTarget =
+    (eqAddress(second.poolId, USDT0_POOL) && eqAddress(second.token1.address, USDT0)) ||
+    (eqAddress(second.poolId, USDCE_POOL) && eqAddress(second.token1.address, USDCE));
+  return eqAddress(tokenIn.wrappedAddress.address, CUSD) &&
+    eqAddress(first.hooks, TEMPO_HOOK) && eqAddress(second.hooks, TEMPO_HOOK) &&
+    eqAddress(first.poolId, CUSD_POOL) && validTarget &&
+    eqAddress(first.token0.address, PATH_USD) && eqAddress(first.token1.address, CUSD) &&
+    eqAddress(second.token0.address, PATH_USD);
+}
